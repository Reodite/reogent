# LLM (LLM_API_TYPE: openai, anthropic, or google)
# Use https for remote proxies: an http -> https redirect strips the
# Authorization header and the upstream rejects the request with 401.
LLM_API_TYPE=openai
LLM_BASE_URL=https://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Database
# Generate separate secrets with: openssl rand -hex 32
# Put the same Postgres password in DATABASE_URL and POSTGRES_PASSWORD.
DATABASE_URL=postgres://reodite:REPLACE_WITH_POSTGRES_PASSWORD@localhost:${POSTGRES_PORT:-5432}/reodite
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
MEILISEARCH_PORT=7700

# Search
MEILI_URL=http://localhost:${MEILISEARCH_PORT:-7700}
MEILI_MASTER_KEY=
# Read-only key the app serves requests with; required in production.
# Create it after Meilisearch starts (see README) and paste its "key" here.
MEILI_API_KEY=

# Auth
AUTH_ENABLED=true
JWT_SECRET=
# OAuth is enabled by default. Set USE_OAUTH=false to use username/password.
USE_OAUTH=true
# When OAuth is enabled, register APP_URL/api/auth/google/callback in Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=

# Data
DATA_PATH=./ubc-unified-data/data

# App
PORT=3000
DB_POOL_MAX=10
DB_POOL_TIMEOUT_MS=10000
# Set only behind a proxy that overwrites this header with one client IP.
# Block direct access to the app when enabling this trust.
TRUSTED_CLIENT_IP_HEADER=
