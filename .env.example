# LLM (LLM_API_TYPE: openai, anthropic, or google)
# Use https for remote proxies: an http -> https redirect strips the
# Authorization header and the upstream rejects the request with 401.
LLM_API_TYPE=openai
LLM_BASE_URL=https://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Database
DATABASE_URL=postgres://reodite:reodite@postgres:5432/reodite
POSTGRES_PASSWORD=reodite

# Search
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change-me-meilisearch-key

# Auth
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production

# Data
DATA_PATH=./ubc-unified-data/data

# App
PORT=3000
