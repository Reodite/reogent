# LLM (LLM_API_TYPE: openai, anthropic, or google)
# Use https for remote proxies: an http -> https redirect strips the
# Authorization header and the upstream rejects the request with 401.
LLM_API_TYPE=openai
LLM_BASE_URL=https://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Database
# Generate separate secrets with: openssl rand -hex 32
# Put the same Postgres password in DATABASE_URL and POSTGRES_PASSWORD.
DATABASE_URL=postgres://reodite:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/reodite
POSTGRES_PASSWORD=

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# Auth
AUTH_ENABLED=true
JWT_SECRET=

# Data
DATA_PATH=./ubc-unified-data/data

# App
PORT=3000
