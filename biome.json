{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  },
  "files": {
    "includes": ["app/**", "src/**", "scripts/**", "!ubc-unified-data", "!ubc-unified-data/**"]
  }
}
